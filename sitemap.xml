---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign site_origin = site.production_url | default: site.url %}
  {% for page in site.pages %}
    {% unless page.url contains '.xml' or page.url contains '.txt' or page.url contains '/contact-us/' or page.url == '/portfolio/' or page.robots == 'noindex, follow' or page.url contains '.json' or page.url contains '.css' or page.url contains '.js' %}
      <url>
        <loc>{{ page.url | relative_url | prepend: site_origin }}</loc>
        {% if page.last_modified_at %}
        <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endunless %}
  {% endfor %}
</urlset>
